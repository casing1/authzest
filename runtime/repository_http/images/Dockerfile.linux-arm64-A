# Separate HTTP-only A/B candidate; not built or runtime accepted.
FROM docker.io/library/python@sha256:df540bfd30bd380e89a349611ce42aa67bcb542d58c047706616eb6ba2f86a1b AS dependencies
COPY requirements.txt /build/requirements.txt
COPY wheels/ /build/wheels/
RUN --network=none /usr/local/bin/python -I -m pip install --no-index --find-links=/build/wheels --only-binary=:all: --no-deps --require-hashes --no-compile --disable-pip-version-check --target=/build/site-packages -r /build/requirements.txt

FROM docker.io/library/python@sha256:df540bfd30bd380e89a349611ce42aa67bcb542d58c047706616eb6ba2f86a1b
COPY --from=dependencies /build/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --chown=0:0 --chmod=0444 assets/_guest_common.py /opt/authzest-repository-http-guest/_guest_common.py
COPY --chown=0:0 --chmod=0444 assets/repository_http_manifest.py /opt/authzest-repository-http-guest/repository_http_manifest.py
COPY --chown=0:0 --chmod=0444 assets/app_launcher.py /opt/authzest-repository-http-guest/app_launcher.py
RUN --network=none mkdir -p /opt/authzest-repository-http-guest /input /input/project && chmod 0555 /opt/authzest-repository-http-guest /input /input/project
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/python","-I","-B","/opt/authzest-repository-http-guest/app_launcher.py"]
CMD []
